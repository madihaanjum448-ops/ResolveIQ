# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible provider (tested with Groq)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_EXTRACT_MODEL=openai/gpt-oss-120b

# Optional transport tuning.
# Transient 429/5xx/timeouts/malformed JSON are retried with backoff.
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=4
# LLM_BACKOFF_BASE=1.0
# LLM_BACKOFF_MAX=30

MODE=suggestion
KILL_SWITCH=off
SUPPLIER_EMAIL=your-second-gmail@gmail.com

# n8n webhook the dashboard calls after "Approve & send"
# (n8n running locally via npx)
N8N_SEND_WEBHOOK=http://localhost:5678/webhook/send-supplier-email
