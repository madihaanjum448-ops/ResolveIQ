# Copy to .env and fill in. Never commit .env.
# PRD option A: Claude. Get a key at https://console.anthropic.com
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EXTRACT_MODEL=claude-haiku-4-5-20251001
# Option B, FREE: Google Gemini (key from https://aistudio.google.com, no card). Use these instead of the 4 lines above:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-flash-latest   (copy the exact free model name shown in AI Studio)
# LLM_EXTRACT_MODEL=gemini-flash-latest
# Option C, FREE: Groq (https://console.groq.com): LLM_PROVIDER=openai, LLM_BASE_URL=https://api.groq.com/openai/v1
MODE=suggestion
KILL_SWITCH=off
SUPPLIER_EMAIL=your-second-gmail@gmail.com
# n8n webhook the dashboard calls after "Approve & send" (n8n running locally via npx)
N8N_SEND_WEBHOOK=http://localhost:5678/webhook/send-supplier-email
